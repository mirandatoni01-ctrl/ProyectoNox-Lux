# NOX & LUX — Variables de entorno (plantilla).
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al repositorio.

# Número de WhatsApp del equipo de ventas en formato internacional sin "+".
# Ejemplo: 573001234567
VITE_WHATSAPP_NUMBER=573000000000

# Entorno de la aplicación: development | production
VITE_APP_ENV=development