# NOX & LUX ADMIN — Variables de entorno (plantilla).
# Copia este archivo a `apps/admin/.env` y completa los valores.
# `.env` no se sube al repositorio.

# URL base de la NOX & LUX API (servidor NestJS de services/api).
VITE_API_URL=http://localhost:3000

# Modo de autenticación:
#   api -> usa los endpoints reales de la API (POST /api/auth/login, /me, refresh...).
#          Requiere el backend levantado con PostgreSQL (ver services/api/.env).
#   dev -> autenticación de demostración local (SOLO desarrollo; NUNCA producción).
VITE_AUTH_MODE=dev