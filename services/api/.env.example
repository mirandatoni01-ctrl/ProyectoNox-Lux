# NOX & LUX API — Variables de entorno (plantilla).
# Copia este archivo a `services/api/.env` y completa los valores.
# NUNCA subas `.env` al repositorio.

# Cadena de conexión PostgreSQL (ADR-NL-005).
# Desarrollo local: levanta la BD con `docker compose up -d` (postgres:16).
DATABASE_URL="postgresql://nox_lux:nox_lux_dev@localhost:5432/nox_lux?schema=public"

# Puerto HTTP del API.
API_PORT=3000

# Orígenes permitidos (CORS, separados por comas): Store y Admin dev.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Autenticación (NL-05, ADR-NL-018) ---
# JWT: firma de sesiones (access corto + refresh rotado en BD).
JWT_ACCESS_SECRET="cambiar-por-secreto-access-seguro"
JWT_REFRESH_SECRET="cambiar-por-secreto-refresh-seguro"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Google OAuth (proveedor de identidad; roles siempre de la BD).
# Crear un OAuth Client en Google Cloud Console y autorizar GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# P. ej. http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL=""

# --- Pedidos y WhatsApp (NL-10) ---
# Número de negocio para el enlace wa.me / notificaciones (E.164, sin '+22').
WHATSAPP_NUMBER="573000000000"
